# Copy to .env (gitignored, never commit) and load per command:
#   cp .env.example .env   # then fill in real values
#   set -a; . ./.env; set +a
# Scripts also work without it: required vars without defaults fail with a
# message, prompt-backed vars ask, the rest fall back to the defaults below.

# --- AWS (tofu provider, aws CLI; sleep.sh, wake.sh, mirror-to-ecr.sh) ---
AWS_REGION=ap-southeast-1
# Alternative to `aws configure` (leave commented if configured):
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Identity (generate-secrets.sh prompts when unset) ---
DOMAIN_NAME=proxy.example.com
ACME_EMAIL=admin@example.com

# --- Cloudflare (setup-dns.sh fails without; wake.sh passes through) ---
CLOUDFLARE_API_TOKEN=
# Optional: skip zone auto-detection:
#CF_ZONE_ID=
# Optional: wait caps in seconds:
#DNS_WAIT_MAX=900
#ACME_WAIT_MAX=600

# --- Paths (all have working defaults; override per host) ---
#SSH_KEY=$HOME/.ssh/china-proxy.pem
#CERT_STORE=$HOME/.china-proxy/certs/proxy.example.com
#INSTANCE_NAME=china-proxy

# --- Optional: end-to-end egress check (README §6) ---
#OPENROUTER_KEY=
