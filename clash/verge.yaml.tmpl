# Clash Verge local profile template. Rendered by scripts/generate-secrets.sh
# (placeholders below) into clients/clash-verge.yaml — never edit the render.
# Import as a LOCAL profile in Clash Verge (Profiles → New → paste file).
# One proxy group (china-auto, url-test over all four outbounds); mainland
# services go DIRECT, everything else rides the group.
mixed-port: 7897
allow-lan: false
mode: rule
log-level: info
external-controller: '127.0.0.1:9097'
unified-delay: true
ipv6: true
profile:
  store-selected: true
tun:
  mtu: 1500
dns:
  enable: true
  ipv6: true
  use-system-hosts: false
  listen: '127.0.0.1:5335'
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter: ['*.lan', 'stun.*.*.*', 'stun.*.*', '+.stun.*.*', '+.stun.*.*.*', time.windows.com, time.nist.gov, time.apple.com, time.asia.apple.com, time1.apple.com, time2.apple.com, time3.apple.com, time4.apple.com, time5.apple.com, time6.apple.com, time7.apple.com, '*.ntp.org.cn', pool.ntp.org, ntp.ubuntu.com, ntp.aliyun.com, '*.time.edu.cn', '*.msftconnecttest.com', '*.msftncsi.com']
  default-nameserver: [system, 180.76.76.76, 8.8.8.8]
  nameserver: ['https://223.5.5.5/dns-query', 'https://doh.pub/dns-query', 'https://dns.alidns.com/dns-query', 'tls://223.5.5.5', 'tls://dot.pub', 'https://cloudflare-dns.com/dns-query']
  fallback-filter: { geoip: true, ipcidr: [240.0.0.0/4, 0.0.0.0/32], domain: [+.google.com, +.facebook.com, +.twitter.com, +.youtube.com, +.google.cn, +.googleapis.cn] }
proxies:
  - name: china-xray
    type: vless
    server: ${DOMAIN_NAME}
    port: 443
    uuid: ${XRAY_UUID}
    network: tcp
    tls: true
    udp: true
    flow: xtls-rprx-vision
    servername: ${REALITY_SNI}
    client-fingerprint: ${REALITY_FP}
    reality-opts:
      public-key: ${REALITY_PUB}
      short-id: ${SHORT_ID}
  - name: china-xray-8443
    type: vless
    server: ${DOMAIN_NAME}
    port: 8443
    uuid: ${XRAY_UUID}
    network: tcp
    tls: true
    udp: true
    flow: xtls-rprx-vision
    servername: ${REALITY_SNI}
    client-fingerprint: ${REALITY_FP}
    reality-opts:
      public-key: ${REALITY_PUB}
      short-id: ${SHORT_ID}
  - name: china-hy2
    type: hysteria2
    server: ${DOMAIN_NAME}
    port: 443
    password: ${HY2_PASSWORD}
    sni: ${DOMAIN_NAME}
    skip-cert-verify: false
    alpn: [h3]
  - name: china-hy2-8443
    type: hysteria2
    server: ${DOMAIN_NAME}
    port: 8443
    password: ${HY2_PASSWORD}
    sni: ${DOMAIN_NAME}
    skip-cert-verify: false
    alpn: [h3]
proxy-groups:
  - name: china-auto
    type: url-test
    proxies: [china-xray, china-hy2, china-xray-8443, china-hy2-8443]
    url: 'https://www.gstatic.com/generate_204'
    interval: 300
